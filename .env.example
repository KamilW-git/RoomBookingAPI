# Skopiuj ten plik jako .env (cp .env.example .env). Plik .env NIE trafia do repozytorium.
# Wszystkie wartości poniżej są przykładowe i nieprawdziwe. Lokalnie (development) aplikacja działa z nimi od razu,
# ale wypisuje ostrzeżenie; w produkcji (NODE_ENV=production) wartości "change_me..." są odrzucane i trzeba
# podać własne (patrz src/config - walidacja wszystkich zmiennych schematem Zod).

# ===== Aplikacja =====
# Port serwera (domyślnie 3000)
# PORT=3000
# Port API wystawiony przez Docker Compose na komputerze (domyślnie 3000)
# API_PORT=3000
# development | test | production (domyślnie development)
# NODE_ENV=development
# Implementacja repositories: knex (PostgreSQL, domyślnie) albo memory (tablice w pamięci)
# STORAGE=knex
# Adres API używany przez skrypty pomocnicze (domyślnie http://localhost:<PORT>)
# BASE_URL=http://localhost:3000
# Poziom logów: info (domyślnie), error (domyślnie w testach) albo silent
# LOG_LEVEL=info

# ===== Baza danych PostgreSQL (Docker Compose czyta POSTGRES_* i DB_PORT z tego pliku) =====
POSTGRES_USER=roombooking
POSTGRES_PASSWORD=change_me
POSTGRES_DB=roombooking
# Port bazy na maszynie lokalnej (5432 bywa zajęty przez lokalną instalację PostgreSQL)
DB_PORT=5433
# Adres połączenia używany przez aplikację i Knex (musi zgadzać się z danymi powyżej)
DATABASE_URL=postgresql://roombooking:change_me@localhost:5433/roombooking
# Osobna baza dla testów integracyjnych (npm run test:integration). Nazwa musi kończyć się na _test
# i różnić od bazy deweloperskiej; jeśli nie istnieje, testy same ją zakładają.
TEST_DATABASE_URL=postgresql://roombooking:change_me@localhost:5433/roombooking_test

# ===== Uwierzytelnianie (JWT, bcrypt) =====
# Sekret do podpisywania tokenów JWT: minimum 32 znaki, losowy ciąg. Wygeneruj np.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters
# Czas życia tokenu: liczba i jednostka s/m/h/d (domyślnie 15m)
JWT_EXPIRES_IN=15m
# Cost factor bcrypt, 10-15 (domyślnie 12)
# BCRYPT_COST=12

# ===== Seed (npm run seed:run) =====
# Hasło konta ADMIN (login: admin@example.com), minimum 10 znaków
SEED_ADMIN_PASSWORD=change_me_admin_password
# Hasło kont demonstracyjnych USER (właściciele przykładowych rezerwacji), minimum 10 znaków
SEED_USER_PASSWORD=change_me_user_password
